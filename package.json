{
  "name": "memobook-1.0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --project=unit",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@primevue/forms": "^4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^2.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.0.12",
    "tailwindcss-primeui": "^0.5.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@tsconfig/node22": "22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-storybook": "^10.6.3",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "sass-loader": "^16.0.8",
    "start-server-and-test": "^2.1.5",
    "storybook": "^10.6.3",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
